# Copy this file to .env and fill in one authentication option.
# Do not commit .env.

# Google AI Studio. Set one API key variable; GOOGLE_API_KEY takes precedence
# when both are present.
GOOGLE_API_KEY=
# GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model used by all agents in the first version.
ADK_MODEL=gemini-flash-latest
