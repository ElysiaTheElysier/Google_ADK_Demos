# Copy this file to .env and fill in one authentication option.
# Do not commit .env.

# Google AI Studio. Set one API key variable; GOOGLE_API_KEY takes precedence
# when both are present.
GOOGLE_API_KEY=
# GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model used by all agents in the first version.
ADK_MODEL=gemini-3.5-flash-lite

# Optional fallback. If Gemini stops producing events or returns 503/429
# (high demand / rate limit), the backend starts a new run with OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4.1-mini
ADK_EVENT_TIMEOUT_SECONDS=60

# Optional external validator target URL (Phase 3 - Promptify).
PROMPTIFY_URL=https://promptify-wheat-seven.vercel.app/
